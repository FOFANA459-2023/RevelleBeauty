# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Build-time (PUBLIC — inlined into the JS bundle, assume the world reads it)
# Leave as /api: the Worker proxies same-origin so session cookies work.
VITE_API_BASE_URL=/api

# ── Deploy-time (SECRET — only needed to run `wrangler deploy` locally)
# Cloudflare dashboard → sidebar for the account ID;
# My Profile → API Tokens → create one with "Workers Scripts: Edit".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Runtime (set on the Worker, not in the bundle)
# The deployed backend origin that /api/* and /uploads/* proxy to.
# API_ORIGIN=https://api.revellebeauty.com

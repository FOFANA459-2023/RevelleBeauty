{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "revellebeauty",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-06",
  "observability": { "enabled": true },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // SPA deep links (/product/high-shine-lip-oil) resolve to index.html.
    // This replaces the Pages-style `_redirects` file, which Workers rejects
    // as an infinite loop.
    "not_found_handling": "single-page-application",
    // These paths must reach the Worker (to be proxied to the API) instead of
    // falling through to the SPA fallback above.
    "run_worker_first": ["/api/*", "/uploads/*"]
  },

  "vars": {
    // Set to the deployed backend origin, e.g. "https://api.revellebeauty.com".
    // Empty means API calls return 503 (see worker/index.js).
    "API_ORIGIN": ""
  }
}
